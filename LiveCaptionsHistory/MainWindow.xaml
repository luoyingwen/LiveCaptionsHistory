<Window x:Class="LiveCaptionsHistory.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:LiveCaptionsHistory"
 Title="字幕历史" Width="820" Height="650" MinWidth="570" MinHeight="380"
 WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundBrush}"
 Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14"
 Loaded="OnLoaded" Closing="OnClosing" PreviewKeyDown="OnKeyDown" PreviewMouseLeftButtonDown="WindowMouseLeftButtonDown">
 <Window.CommandBindings>
  <CommandBinding Command="{x:Static local:MainWindow.ToggleCompactCommand}" Executed="ToggleCompactExecuted"/>
  <CommandBinding Command="{x:Static local:MainWindow.ExitCompactCommand}" Executed="ExitCompactExecuted" CanExecute="CompactCommandCanExecute"/>
  <CommandBinding Command="{x:Static local:MainWindow.MoveCompactCommand}" Executed="MoveCompactExecuted" CanExecute="CompactCommandCanExecute"/>
 </Window.CommandBindings>
 <Window.InputBindings>
  <KeyBinding Key="M" Modifiers="Control+Shift" Command="{x:Static local:MainWindow.ToggleCompactCommand}"/>
  <KeyBinding Key="Escape" Command="{x:Static local:MainWindow.ExitCompactCommand}"/>
  <KeyBinding Key="Left" Modifiers="Alt" Command="{x:Static local:MainWindow.MoveCompactCommand}" CommandParameter="left"/>
  <KeyBinding Key="Right" Modifiers="Alt" Command="{x:Static local:MainWindow.MoveCompactCommand}" CommandParameter="right"/>
  <KeyBinding Key="Up" Modifiers="Alt" Command="{x:Static local:MainWindow.MoveCompactCommand}" CommandParameter="up"/>
  <KeyBinding Key="Down" Modifiers="Alt" Command="{x:Static local:MainWindow.MoveCompactCommand}" CommandParameter="down"/>
 </Window.InputBindings>
 <Grid x:Name="RootLayout" Margin="24,18,24,16">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <Grid x:Name="HeaderPanel" Margin="0,0,0,18">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel>
    <TextBlock Text="字幕历史" FontSize="26" FontWeight="SemiBold"/>
    <TextBlock x:Name="SourceStatus" Text="正在启动本机识别引擎…" Foreground="{StaticResource MutedBrush}" Margin="0,6,12,0" TextWrapping="Wrap"/>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0"/>
    <TextBlock x:Name="RecordStatus" Text="正在记录" VerticalAlignment="Center"/>
   </StackPanel>
  </Grid>
  <WrapPanel x:Name="ToolbarPanel" Grid.Row="1" Margin="0,0,0,12">
   <Button x:Name="PauseButton" Content="暂停记录" Click="PauseClick" Margin="0,0,8,8" AutomationProperties.AutomationId="PauseCapture" ToolTip="暂停时不保存新字幕；恢复后只记录新的内容"/>
   <Button Content="复制全部" Click="CopyClick" Margin="0,0,8,8" AutomationProperties.AutomationId="CopyTranscript"/>
   <Button Content="导出文本" Click="ExportClick" Margin="0,0,8,8" AutomationProperties.AutomationId="ExportTranscript"/>
   <Button Content="重新连接" Click="ReconnectClick" Margin="0,0,8,8" AutomationProperties.AutomationId="ReconnectEngine" ToolTip="重新连接本机识别引擎，保留已有历史"/>
   <Button Content="精炼模式" Click="CompactModeClick" Margin="0,0,8,8" AutomationProperties.AutomationId="CompactMode"
     ToolTip="仅显示字幕。拖动上沿移动；Esc 返回完整界面。快捷键 Ctrl+Shift+M"/>
   <StackPanel Orientation="Horizontal" Margin="0,0,16,8" Height="36">
    <TextBlock Text="识别语言" VerticalAlignment="Center" Margin="0,0,8,0"/>
    <ComboBox x:Name="LanguagePicker" Width="130" VerticalContentAlignment="Center" IsEnabled="False"
      DisplayMemberPath="Name" SelectedValuePath="Code" SelectionChanged="LanguageChanged"
      AutomationProperties.Name="识别语言" AutomationProperties.AutomationId="RecognitionLanguage"/>
   </StackPanel>
   <StackPanel Orientation="Horizontal" Margin="0,0,16,8" Height="36">
    <TextBlock Text="字号" VerticalAlignment="Center" Margin="0,0,8,0"/>
    <ComboBox x:Name="FontPicker" Width="62" VerticalContentAlignment="Center" SelectionChanged="FontChanged" SelectedIndex="1"
      AutomationProperties.Name="字幕字号" AutomationProperties.AutomationId="CaptionFontSize">
     <ComboBoxItem Content="16"/><ComboBoxItem Content="18"/><ComboBoxItem Content="20"/><ComboBoxItem Content="24"/><ComboBoxItem Content="28"/>
    </ComboBox>
   </StackPanel>
   <CheckBox x:Name="TopmostCheck" Content="窗口置顶" VerticalAlignment="Center" Margin="0,0,0,8" Height="36" Checked="TopmostChanged" Unchecked="TopmostChanged"/>
  </WrapPanel>
  <Border x:Name="TranscriptPanel" Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid x:Name="TranscriptHeading" Margin="18,12">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="SessionLabel" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
     <TextBlock Grid.Column="1" x:Name="CountLabel" Text="0 字" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
    </Grid>
    <Grid Grid.Row="1">
     <TextBox x:Name="TranscriptBox" IsReadOnly="True" IsUndoEnabled="False" AcceptsReturn="True" TextWrapping="Wrap"
      VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" BorderThickness="0" Padding="18,4,14,20"
      FontSize="18" Foreground="{StaticResource TextBrush}" Background="Transparent"
      AutomationProperties.Name="字幕历史正文" AutomationProperties.AutomationId="TranscriptHistory"
      ScrollViewer.ScrollChanged="TranscriptScrolled" PreviewMouseWheel="TranscriptWheel">
      <TextBox.ContextMenu>
       <ContextMenu Opened="TranscriptMenuOpened">
        <MenuItem x:Name="MenuSourceStatus" IsEnabled="False"/>
        <Separator/>
        <MenuItem x:Name="MenuCompactMode" Header="精炼模式" InputGestureText="Ctrl+Shift+M" Click="CompactModeClick"/>
        <MenuItem x:Name="MenuMoveWindow" Header="移动窗口">
         <MenuItem Header="向左移动" InputGestureText="Alt+←" Tag="left" Click="MoveWindowClick"/>
         <MenuItem Header="向右移动" InputGestureText="Alt+→" Tag="right" Click="MoveWindowClick"/>
         <MenuItem Header="向上移动" InputGestureText="Alt+↑" Tag="up" Click="MoveWindowClick"/>
         <MenuItem Header="向下移动" InputGestureText="Alt+↓" Tag="down" Click="MoveWindowClick"/>
        </MenuItem>
        <MenuItem x:Name="MenuTopmost" Header="窗口置顶" IsCheckable="True" Click="MenuTopmostClick"/>
        <MenuItem x:Name="MenuPause" Header="暂停记录" Click="PauseClick"/>
        <MenuItem Header="回到最新" InputGestureText="Ctrl+End" Click="LatestClick"/>
        <Separator/>
        <MenuItem x:Name="MenuCopySelection" Header="复制选中文字" InputGestureText="Ctrl+C" Click="CopySelectionClick"/>
        <MenuItem Header="复制全部" Click="CopyClick"/>
        <MenuItem Header="导出文本" Click="ExportClick"/>
        <Separator/>
        <MenuItem Header="关闭窗口" InputGestureText="Alt+F4" Click="CloseWindowClick"/>
       </ContextMenu>
      </TextBox.ContextMenu>
     </TextBox>
     <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Margin="24">
      <TextBlock Text="让字幕留下来" FontSize="23" FontWeight="SemiBold" TextAlignment="Center"/>
      <TextBlock Text="选择识别语言并播放有声音的内容，字幕会显示在这里。&#10;向上滚动即可回看，新的文字会继续记录。"
       FontSize="15" Foreground="{StaticResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="25"/>
     </StackPanel>
     <TextBlock x:Name="CompactEmptyState" Text="等待字幕…" Visibility="Collapsed" IsHitTestVisible="False"
       Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
    <Border x:Name="FollowPanel" Grid.Row="2" Background="{StaticResource BackgroundBrush}" Padding="14,9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="FollowStatus" Text="跟随最新字幕" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0" TextWrapping="Wrap"/>
      <Button Grid.Column="1" x:Name="LatestButton" Content="回到最新" Margin="0" Click="LatestClick"
       AutomationProperties.AutomationId="FollowLatest" MinWidth="110"/>
     </Grid>
    </Border>
   </Grid>
  </Border>
  <Border x:Name="CompactDragArea" Grid.Row="2" Visibility="Collapsed" Height="16" VerticalAlignment="Top"
    Margin="8,6,28,0" Background="Transparent" Cursor="SizeAll" MouseLeftButtonDown="CompactDragMouseDown"
    AutomationProperties.Name="拖动字幕窗口" ToolTip="拖动移动窗口，也可按住 Alt 拖动字幕区；Esc 返回完整界面"/>
  <Grid x:Name="FooterPanel" Grid.Row="3" Margin="0,14,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
    <TextBlock x:Name="SaveStatus" Text="自动保存到本机" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>
    <TextBlock x:Name="Notice" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
   </StackPanel>
   <Button Grid.Column="1" Content="历史文件" Click="OpenHistoryClick" Margin="0" ToolTip="打开本机自动保存目录"/>
  </Grid>
 </Grid>
</Window>
