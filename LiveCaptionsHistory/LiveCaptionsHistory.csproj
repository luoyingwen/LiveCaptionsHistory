<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LiveCaptionsHistory</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SpeechBackendHost\SpeechBackendHost.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <Target Name="CopySpeechBackend" AfterTargets="Build">
    <ItemGroup>
      <SpeechBackendFiles Include="..\SpeechBackendHost\bin\$(Configuration)\net8.0-windows\SpeechBackendHost.*" Exclude="**\*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(SpeechBackendFiles)" DestinationFolder="$(OutDir)engine" />
  </Target>
  <Target Name="PublishSpeechBackend" AfterTargets="Publish">
    <Copy SourceFiles="@(SpeechBackendFiles)" DestinationFolder="$(PublishDir)engine" />
  </Target>
</Project>
